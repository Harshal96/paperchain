#!/bin/sh
set -eu
if [ "${1:-}" = "--from-executable" ]; then
    if [ "$#" -ne 3 ]; then
        echo 'Usage: sh scripts/bundle --from-executable EXECUTABLE APP' >&2
        exit 2
    fi
    executable=$2
    app=$3
else
    sh scripts/swiftpm build -c release --product PaperChain "$@"
    bin=$(sh scripts/swiftpm build -c release --show-bin-path "$@")
    executable="$bin/PaperChain"
    app="dist/Paper Chain.app"
fi
mkdir -p "$app/Contents/MacOS"
cp "$executable" "$app/Contents/MacOS/PaperChain"
cp Resources/Info.plist "$app/Contents/Info.plist"
identity=${PAPERCHAIN_SIGN_IDENTITY:-}
if [ -z "$identity" ]; then
    identity=$(security find-identity -v -p codesigning |
        awk '/"Paperchain Local Signing"$/ && !found { print $2; found=1 }')
fi
if [ -z "$identity" ] || [ "$identity" = "-" ]; then
    identity=-
    echo 'Using an ad-hoc signature. A changed build can require Accessibility access again.' >&2
fi
codesign --force --sign "$identity" "$app"
codesign --verify --strict --deep "$app"
echo "$app"
